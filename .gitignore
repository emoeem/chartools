# Build
/build/
/cn/build/
/cn/app/build/
# 旧布局残留（根目录 app/ 的旧构建产物；代码已迁 cn/，此目录可随时删除）
/app/build/
.gradle/
*.apk
*.ap_
*.dex
*.class
local.properties

# Machine-specific
env.ps1
gradle.properties.local
# 沙箱内构建用的 GRADLE_USER_HOME 副本（~/.gradle 在沙箱里只读，见 _reports/s3-l1-telegram_report.md）
/.gradle-home/
/.android-home/

# IDE
.idea/
*.iml
.vscode/

# Dev artifacts / reports (not part of the product)
/_reports/
/cn/tools/jev/report/
**/__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db

# Never commit secrets
*.key
secrets.*

# Prebuilt APK for direct install (tracked on purpose)
!/cn/apk/*.apk

# Signing material never enters the repo
*.jks
*.keystore
keystore.properties

# Security scan artifacts
.mimosa/

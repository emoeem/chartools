<?xml version="1.0" encoding="utf-8"?>
<!-- 只进 debug 变体：注册 DebugHooksInit，让调试验收钩子在任何 Activity 之前挂上。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <provider
            android:name=".DebugHooksInit"
            android:authorities="${applicationId}.debughooks"
            android:exported="false" />
    </application>

</manifest>
